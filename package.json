{
  "name": "snippy",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "build": "npm run lint && node build.js",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && npm run typecheck",
    "package-extension": "node scripts/package-extension.mjs",
    "format": "prettier --write \"**/*.{js,cjs,mjs,mts,ts,tsx,json,md,css}\"",
    "prepare": "node .husky/install.mjs",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^7.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/dongle": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@phosphor-icons/react": "^2.1.10",
    "@recursica/adapter-mantine-v8": "^1.2.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
