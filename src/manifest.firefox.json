{
  "manifest_version": 3,
  "name": "Snippy",
  "description": "Snippy by Recursica: capture comments, screenshots and page elements on any website, annotate them, and export one HTML report.",
  "author": "Recursica",
  "homepage_url": "https://recursica.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle Snippy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "MacCtrl+Shift+K"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "snippy@borderux.com"
    }
  }
}
