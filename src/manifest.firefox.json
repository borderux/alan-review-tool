{
  "manifest_version": 3,
  "name": "Tagger",
  "version": "0.1.0",
  "description": "Slide-out review panel for capturing website feedback on any site.",
  "action": {
    "default_title": "Toggle Tagger"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "tagger@borderux.com"
    }
  }
}
