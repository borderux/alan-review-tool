{
  "manifest_version": 3,
  "name": "Alan Review Tool",
  "version": "0.1.0",
  "description": "Slide-out review overlay for capturing website feedback on any site.",
  "action": {
    "default_title": "Toggle Alan Review Tool"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "alan-logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "alan-review-tool@borderux.com"
    }
  }
}
